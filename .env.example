POSTGRES_DB=eamms
POSTGRES_USER=eamms
POSTGRES_PASSWORD=eamms_local_dev_password

# Used by the backend. Keep the host as localhost when running the API on your machine.
DATABASE_URL=postgresql+psycopg://eamms:eamms_local_dev_password@localhost:5432/eamms
JWT_SECRET_KEY=local-dev-only-change-this-random-secret-before-deployment
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
# Single company accounting currency; must be a valid ISO 4217 alpha-3 code.
COMPANY_CURRENCY=INR
# Baked into the frontend image at build time.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
APP_ENV=development
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
